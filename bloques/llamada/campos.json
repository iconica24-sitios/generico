{
  "label": "Llamada a la acción",
  "name": "llamada",
  "widget": "object",
  "summary": "Llamada — {{fields.titulo}}",
  "fields": [
    {
      "label": "Título",
      "name": "titulo",
      "widget": "string",
      "default": "Una invitación final, directa y breve."
    },
    {
      "label": "Botón",
      "name": "boton",
      "widget": "object",
      "fields": [
        {
          "label": "Texto",
          "name": "texto",
          "widget": "string",
          "required": false,
          "default": "Empezar",
          "hint": "Vacío = sin botón."
        },
        {
          "label": "Enlace",
          "name": "enlace",
          "widget": "string",
          "required": false,
          "default": "#contacto",
          "hint": "#ancla, /pagina o https://…"
        }
      ]
    },
    {
      "label": "Ancla para el menú",
      "name": "ancla",
      "widget": "string",
      "required": false,
      "default": "",
      "hint": "Sin espacios (p. ej. precios): el menú la enlaza como #precios. Vacío = sin ancla.",
      "pattern": [
        "^[a-z0-9-]*$",
        "Sólo minúsculas, números y guiones"
      ]
    }
  ]
}